{
  "name": "nothumanallowed",
  "version": "16.0.63",
  "description": "Local AI assistant: 80 tools (Gmail, Calendar, Drive, GitHub, Slack, browser, code, files), 38 agents, visual workflows (Studio, AWF, WebCraft). Install with `npm i -g nothumanallowed`, run with `nha ui`. Free tier built-in (Liara), no API key required. Your data stays on your PC — OAuth tokens local, no cloud. Open-source MIT.",
  "type": "module",
  "bin": {
    "nha": "bin/nha",
    "nothumanallowed": "bin/nha"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "deliberation",
    "orchestration",
    "llm",
    "nothumanallowed",
    "legion",
    "consensus",
    "reasoning",
    "epistemic",
    "anthropic",
    "openai",
    "gemini",
    "deepseek",
    "telegram-bot",
    "discord-bot",
    "voice-assistant",
    "daily-ops",
    "gmail",
    "calendar",
    "github",
    "notion",
    "slack",
    "contacts",
    "drive",
    "scheduler",
    "proactive"
  ],
  "author": "Nicola Cucurachi <ados.labsproject@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adoslabsproject-gif/nothumanallowed.git"
  },
  "homepage": "https://nothumanallowed.com",
  "scripts": {
    "check-bundle": "node check-bundle.mjs",
    "build:ui": "cd ../nha-ui && pnpm build",
    "prebuild": "cd ../nha-ui && pnpm build",
    "test": "node test/sandbox.test.mjs",
    "prepublishOnly": "node check-bundle.mjs && node test/sandbox.test.mjs"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "acorn-jsx": "^5.3.2",
    "imapflow": "^1.3.3",
    "mailparser": "^3.9.8",
    "typescript": "^6.0.3",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  }
}
